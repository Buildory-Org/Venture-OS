NODE_ENV=development
APP_MODE=local
PORT=4000
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
MONGODB_URI=mongodb://127.0.0.1:27018/venture_studio_dev?replicaSet=ventureStudio
MONGODB_DB=venture_studio_dev
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ALLOW_DEV_AUTH=true
# Optional in local mode; omitted integrations use explicitly labelled local adapters.
# RESEND_API_KEY=
# EMAIL_FROM=Venture Studio <noreply@example.com>
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=venture-studio
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
